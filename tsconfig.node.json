{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": [
    "bench.ts",
    "bench.config.ts",
    "build/**/*.ts",
    "meteor-source.ts",
    "cli/**/*.ts",
    "collectors/**/*.ts",
    "collectors/**/*.cts",
    "drivers/**/*.ts",
    "lib/**/*.ts",
    "reliability/**/*.ts",
    "reporters/**/*.ts",
    "runner/**/*.ts",
    "scripts/helpers/**/*.cts",
    "tests/unit/**/*.ts",
    "tests/fanout-bench.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["apps", "dist", "node_modules", "typescript-tools"]
}
