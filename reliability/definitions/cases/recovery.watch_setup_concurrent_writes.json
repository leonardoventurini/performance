{
  "schemaVersion": 1,
  "id": "recovery.watch_setup_concurrent_writes",
  "title": "recovery — watch setup concurrent writes",
  "source": "https://www.mongodb.com/docs/manual/administration/change-streams-production-recommendations/",
  "rationale": "Required witnessed Change Stream or topology recovery behavior.",
  "applicability": [
    {
      "topologies": [
        "replica_set"
      ],
      "transports": [
        "sockjs"
      ],
      "observerOrders": [
        [
          "changeStreams",
          "oplog",
          "polling"
        ]
      ]
    }
  ],
  "parameters": {
    "subscribers": {
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "maximum": 12
    },
    "documents": {
      "type": "integer",
      "default": 1,
      "minimum": 1,
      "maximum": 120
    },
    "payloadBytes": {
      "type": "integer",
      "default": 65536,
      "minimum": 1,
      "maximum": 15728640
    }
  },
  "fixture": {
    "collection": "reliabilityDocuments",
    "publication": "reliability.documents",
    "generator": "synthetic-document-v1",
    "subscribers": {
      "kind": "parameter",
      "name": "subscribers"
    },
    "documents": {
      "kind": "literal",
      "value": 1
    },
    "payloadBytes": {
      "kind": "parameter",
      "name": "payloadBytes"
    }
  },
  "preconditions": [
    {
      "kind": "topology_matches_coordinate"
    },
    {
      "kind": "transport_available",
      "transport": {
        "kind": "coordinate",
        "field": "transport"
      }
    }
  ],
  "steps": [
    {
      "id": "subscribe",
      "kind": "subscribe",
      "query": {
        "kind": "unordered"
      },
      "onFailure": "incomplete_case",
      "clients": {
        "kind": "parameter",
        "name": "subscribers"
      }
    },
    {
      "id": "ready",
      "kind": "wait",
      "predicate": "all_subscribers_ready",
      "inputs": {},
      "onFailure": "incomplete_case"
    },
    {
      "id": "activate-fault",
      "kind": "fault",
      "operation": "activate",
      "controller": "watch_setup_pause",
      "faultId": "primary-fault",
      "onFailure": "incomplete_case"
    },
    {
      "id": "insert-fixture",
      "kind": "mongo_write",
      "operation": "insert_one",
      "selector": {
        "kind": "fixture_document",
        "index": 0
      },
      "mutation": {
        "kind": "fixture_document",
        "index": 0
      },
      "expectedTransition": {
        "kind": "insert"
      },
      "onFailure": "fail_case"
    },
    {
      "id": "exercise",
      "kind": "mongo_write",
      "operation": "update_one",
      "selector": {
        "kind": "fixture_document",
        "index": 0
      },
      "mutation": {
        "kind": "increment",
        "amount": 1,
        "path": [
          "counter"
        ]
      },
      "expectedTransition": {
        "kind": "increment_field",
        "amount": 1,
        "path": [
          "counter"
        ]
      },
      "onFailure": "fail_case"
    },
    {
      "id": "schedule-barrier",
      "kind": "barrier",
      "participants": {
        "kind": "parameter",
        "name": "subscribers"
      },
      "schedule": "concurrent",
      "onFailure": "fail_case"
    },
    {
      "id": "converge",
      "kind": "wait",
      "predicate": "all_subscribers_converged",
      "inputs": {},
      "onFailure": "fail_case"
    },
    {
      "id": "mongo-snapshot",
      "kind": "snapshot",
      "producer": "mongodb",
      "scope": "mongodb",
      "onFailure": "incomplete_case"
    },
    {
      "id": "ddp-snapshot",
      "kind": "snapshot",
      "producer": "ddp_client",
      "scope": "ddp",
      "onFailure": "incomplete_case"
    },
    {
      "id": "restore-fault",
      "kind": "fault",
      "operation": "restore",
      "controller": "watch_setup_pause",
      "faultId": "primary-fault",
      "onFailure": "incomplete_case"
    },
    {
      "id": "seal",
      "kind": "seal_evidence",
      "onFailure": "incomplete_case"
    }
  ],
  "evidence": {
    "requiredProducers": [
      "mongodb",
      "ddp_client",
      "meteor_probe",
      "fault_controller"
    ],
    "observer": {
      "kind": "selected",
      "driver": {
        "kind": "literal",
        "value": "changeStreams"
      }
    },
    "transportIdentity": "diagnostic",
    "fault": {
      "kind": "activated_and_restored",
      "controller": "watch_setup_pause"
    },
    "ledgers": [
      "mongodb_snapshot",
      "ddp_snapshot",
      "observer_selection",
      "fault_witness"
    ]
  },
  "oracles": [
    {
      "id": "mongodb-state",
      "family": "snapshot_exact",
      "producer": "mongodb",
      "expected": {
        "kind": "step",
        "stepId": "exercise",
        "output": "expectedState"
      },
      "observed": {
        "producer": "mongodb",
        "stepId": "mongo-snapshot",
        "ledger": "snapshot"
      },
      "failureReason": "content_digest_mismatch",
      "gate": "hard"
    },
    {
      "id": "ddp-state",
      "family": "snapshot_exact",
      "producer": "ddp_client",
      "expected": {
        "kind": "step",
        "stepId": "exercise",
        "output": "expectedState"
      },
      "observed": {
        "producer": "ddp_client",
        "stepId": "ddp-snapshot",
        "ledger": "snapshot"
      },
      "failureReason": "content_digest_mismatch",
      "gate": "hard"
    },
    {
      "id": "observer-driver",
      "family": "observer_identity",
      "producer": "meteor_probe",
      "expected": {
        "kind": "literal",
        "value": "changeStreams"
      },
      "observed": {
        "producer": "meteor_probe",
        "stepId": "subscribe",
        "ledger": "observer_selection"
      },
      "failureReason": "observer_identity_mismatch",
      "gate": "hard"
    },
    {
      "id": "cleanup",
      "family": "cleanup_complete",
      "producer": "mongodb",
      "expected": {
        "kind": "literal",
        "value": true
      },
      "observed": {
        "producer": "mongodb",
        "stepId": "cleanup",
        "ledger": "cleanup"
      },
      "failureReason": "recovery_incomplete",
      "gate": "hard"
    },
    {
      "id": "fault",
      "family": "fault_witness",
      "producer": "fault_controller",
      "expected": {
        "kind": "literal",
        "value": {
          "activated": true,
          "restored": true
        }
      },
      "observed": {
        "producer": "fault_controller",
        "stepId": "restore-fault",
        "ledger": "fault_witness"
      },
      "failureReason": "fault_witness_missing",
      "gate": "hard"
    }
  ],
  "diagnostics": [
    {
      "kind": "propagation_latency",
      "fromStep": "exercise"
    },
    {
      "kind": "event_counts"
    }
  ],
  "cleanup": {
    "kind": "run_scoped",
    "verifyEmpty": true
  },
  "budget": {
    "maximumSteps": 16,
    "maximumDocuments": 120,
    "maximumSubscribers": 12,
    "maximumPayloadBytes": 15728640,
    "maximumEvidenceEntries": 10000,
    "stepTimeoutMs": 30000,
    "caseTimeoutMs": 180000,
    "maximumRetries": 0
  },
  "sharing": "isolated"
}
