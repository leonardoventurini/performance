{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "@playwright/test"],
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "tsBuildInfoFile": "dist/.playwright.tsbuildinfo"
  },
  "include": [
    "playwright.config.ts",
    "tests/ddp-helpers.ts",
    "tests/test-helpers.ts",
    "tests/*.spec.ts",
    "types/**/*.d.ts"
  ]
}
