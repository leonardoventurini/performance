{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024"],
    "types": ["node"],
    "rootDir": "typescript-tools",
    "outDir": ".typescript-tools",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false
  },
  "include": ["typescript-tools/**/*.ts"]
}
