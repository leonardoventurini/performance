{
  "name": "performance",
  "version": "1.0.0",
  "type": "module",
  "main": "bench.js",
  "scripts": {
    "build:tools": "tsc -p tsconfig.tools.json --pretty false",
    "clean": "npm run build:tools && node .typescript-tools/clean.js",
    "build": "npm run build:tools && node .typescript-tools/build.js",
    "verify:build": "npm run build:tools && node .typescript-tools/manifest.js",
    "test:source-inventory": "npm run build:tools && node .typescript-tools/inventory.js",
    "test": "npm run build && node --test 'dist/tests/unit/**/*.test.js'",
    "typecheck:node": "tsc -b tsconfig.node.json tsconfig.playwright.json tsconfig.hosts.json --pretty false",
    "typecheck:all": "tsc -b --pretty false",
    "typecheck": "npm run typecheck:all"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.2",
    "@types/ejson": "^2.2.2",
    "@types/node": "^24.13.3",
    "@types/pidusage": "^2.0.5",
    "@types/ws": "^8.18.1",
    "artillery": "^2.0.17",
    "m": "^1.9.0",
    "pidusage": "^3.0.2",
    "typescript": "^7.0.2"
  },
  "volta": {
    "node": "24.0.0"
  },
  "dependencies": {
    "ejson": "^2.2.3",
    "mongodb": "^7.2.0",
    "simpleddp": "^2.2.4",
    "ws": "^8.20.0"
  }
}
